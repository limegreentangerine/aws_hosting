option_settings:
  aws:elasticbeanstalk:application:environment:
    CONCRETE5_ENV: live

commands:
  00_install_node:
    test: "! /usr/bin/node -v 2>/dev/null | grep -q '^v22\\.'"
    command: |
      curl -fsSL https://rpm.nodesource.com/setup_22.x | bash -
      (dnf install -y nodejs || yum install -y nodejs)

container_commands:
  01_dirs:
    command: |
      mkdir -p public/application/files public/application/config/generated_overrides public/application/config/doctrine/proxies
      chown -R webapp:webapp public/application/files public/application/config
      chmod -R 775 public/application/files public/application/config
  02_entities:
    command: "sudo -E -u webapp ./vendor/bin/concrete c5:entities:refresh"
    ignoreErrors: true
  03_packages:
    command: "sudo -E -u webapp ./vendor/bin/concrete c5:package:update --all --quiet"
    ignoreErrors: true
  04_clear_cache:
    command: "sudo -E -u webapp ./vendor/bin/concrete c5:clear-cache"
    ignoreErrors: true
  05_npm:
    command: "sudo -E -u webapp sh -c 'npm ci --include=dev --no-audit --no-fund && npm run prod'"
    env:
      HOME: /home/webapp
