{
	"name": "limegreentangerine/aws_hosting",
	"description": "ConcreteCMS tools for AWS hosted deployments",
	"type": "concrete5-package",
	"license": "proprietary",
	"autoload": {
		"psr-4": {
			"Aws\\": "src/"
		}
	},
	"authors": [
		{
			"name": "Lee Jones",
			"email": "prolific.jones82@gmail.com"
		}
	],
	"minimum-stability": "stable",
	"require-dev": {
		"php": "^8.4",
		"phpunit/phpunit": "^13.3",
		"concrete5/core": "^9.2",
		"friendsofphp/php-cs-fixer": "^3.95"
	},
	"config": {
		"allow-plugins": {
			"mlocati/composer-patcher": true
		}
	},
	"require": {
		"composer-runtime-api": "^2.2",
		"limegreentangerine/class_kit": "^1.0"
	},
	"scripts": {
		"test": "php -d error_reporting=8191 vendor/bin/phpunit",
		"test-coverage": "php -d error_reporting=8191 vendor/bin/phpunit --coverage-text",
		"format:php": "php-cs-fixer fix",
		"format:php:check": "php-cs-fixer check --diff",
		"format:js": "npx prettier --write .",
		"format:js:check": "npx prettier --check .",
		"format": [
			"@format:php",
			"@format:js"
		],
		"format:check": [
			"@format:php:check",
			"@format:js:check"
		],
		"post-install-cmd": [
			"npm install"
		]
	},
	"bin": [
		"bin/install-ebextensions"
	]
}
